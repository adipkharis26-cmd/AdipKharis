<mxfile host="app.diagrams.net"><diagram name="Tahapan Prototyping" id="01-tahapan-prototyping.drawio"><mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="&lt;b&gt;1. Identifikasi Kebutuhan&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:12px&amp;quot;&gt;observasi, wawancara, studi pustaka&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;strokeWidth=1.5;fontSize=14;fontFamily=Times New Roman;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="20" width="280" height="64" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;2. Perancangan Prototipe&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:12px&amp;quot;&gt;use case, activity diagram, desain Figma&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;strokeWidth=1.5;fontSize=14;fontFamily=Times New Roman;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="130" width="280" height="64" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;3. Evaluasi Prototipe&lt;/b&gt;&lt;br&gt;&lt;font style=&amp;quot;font-size:12px&amp;quot;&gt;dicoba dan dinilai oleh pemilik lahan&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;strokeWidth=1.5;fontSize=14;fontFamily=Times New Roman;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="60" y="240" width="280" height="64" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Sudah sesuai?&lt;/b&gt;" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#000000;fillColor=#FFFFFF;strokeWidth=1.5;fontSize=14;fontFamily=Times New Roman;fontColor=#000000;" vertex="1" parent="1"><mxGeometry x="110" y="350" width="180" height="90" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;4. Perbaikan Prototipe&lt;/b&g