{
  "name": "animasi-kusaka",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "voice": "node scripts/generate-voice.mjs",
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts KusakaEpisode out/episode-16x9.mp4",
    "render:shorts": "remotion render src/index.ts KusakaEpisodeShorts out/episode-shorts.mp4",
    "still": "remotion still src/index.ts KusakaEpisode out/still.png",
    "check:characters": "node scripts/character-lock.mjs check",
    "lock:characters": "node scripts/character-lock.mjs lock",
    "sheets": "node scripts/render-sheets.mjs",
    "prevoice": "npm run check:characters --silent",
    "prerender": "npm run check:characters --silent",
    "prerender:shorts": "npm run check:characters --silent",
    "voice:samples": "node scripts/voice-samples.mjs",
    "sfx": "node scripts/generate-sfx.mjs && ./scripts/normalize-sfx.sh",
    "brand": "node scripts/render-brand.mjs",
    "audit:props": "node scripts/audit-props.mjs",
    "beds": "node scripts/generate-beds.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.540",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.540"
  },
  "devDependencies": {
    "@fontsource/baloo-2": "^5.1.0",
    "@fontsource/bangers": "^5.1.0",
    "@types/react": "18.3.12",
    "typescript": "5.6.3"
  }
}